{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-dungeon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "ACTION_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  // To enable AI, create a D1 database in Cloudflare (daily-dungeon-playtest),
  // run migrations/0001_ai_budget.sql, then add the binding below with its real ID.
  // "d1_databases": [
  //   { "binding": "DAILY_BUDGET_DB", "database_name": "daily-dungeon-playtest", "database_id": "YOUR-CLOUDFLARE-D1-ID" }
  // ],
  "vars": {
    "AI_ENABLED": "false",
    "AI_DAILY_LIMIT": "36"
  }
}
