{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-dungeon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "AI_ENABLED": "false"
  }
}
